{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces"],
  "modules-center": ["sway/window"],
  "modules-right": ["custom/pomodoro", "cpu", "custom/disk", "memory", "battery", "custom/vpn", "clock"],
  "sway/window": {
    "format": "{}",
    "max-length": 50
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2
  },
  "custom/disk": {
    "exec": "~/.local/bin/public-scripts/disk_usage",
    "interval": 30,
    "format": "{}",
    "tooltip": true,
    "return-type": "json"
  },
  "memory": {
    "format": "MEM {used:0.1f}G",
    "interval": 2
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% (C)",
    "format-plugged": "BAT {capacity}% (C)",
    "format-warning": "BAT {capacity}%",
    "format-critical": "BAT {capacity}%",
    "interval": 30
  },
  "custom/vpn": {
    "exec": "~/.local/bin/public-scripts/vpn_status",
    "interval": 10,
    "format": "{}",
    "tooltip": true,
    "return-type": "json"
  },
  "clock": {
    "format": "{:%H:%M  %a %d %b}",
    "interval": 1
  }
}
