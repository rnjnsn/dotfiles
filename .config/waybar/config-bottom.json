{
  "layer": "top",
  "position": "bottom",
  "height": 30,
  "modules-left": [
    "custom/hint-todo", "custom/todo"
  ],
  "modules-center": [
    "custom/wotd",
    "custom/wotd-en",
    "custom/wotd-de",
    "custom/wotd-fr",
    "custom/wotd-it",
    "custom/wotd-lat"
  ],
  "modules-right": [],
  "custom/hint-todo": {"exec": "~/.config/waybar/scripts/hint.sh 'a o'", "interval": "once", "signal": 12, "return-type": "json", "tooltip": false},
  "custom/todo": {
    "exec": "/home/rene/.local/bin/public-scripts/todo status",
    "interval": 10,
    "format": "{}",
    "tooltip": true,
    "return-type": "json",
    "on-click": "/home/rene/.local/bin/public-scripts/todo menu",
    "signal": 9,
    "on-click-right": "/home/rene/.local/bin/public-scripts/todo plan"
  },
  "custom/wotd": {
    "exec": "/usr/bin/python3 /home/rene/.config/waybar/scripts/wotd.py",
    "interval": "once",
    "format": "{}",
    "tooltip": true,
    "return-type": "json",
    "signal": 11
  },
  "custom/wotd-en": {
    "exec": "/usr/bin/python3 /home/rene/.config/waybar/scripts/wotd_lang.py en",
    "interval": 3600,
    "format": "  EN: {}",
    "tooltip": true,
    "return-type": "json",
    "on-click-right": "/usr/bin/python3 /home/rene/.config/waybar/scripts/save_word.py en",
    "signal": 8
  },
  "custom/wotd-de": {
    "exec": "/usr/bin/python3 /home/rene/.config/waybar/scripts/wotd_lang.py de",
    "interval": 3600,
    "format": " · DE: {}",
    "tooltip": true,
    "return-type": "json",
    "on-click-right": "/usr/bin/python3 /home/rene/.config/waybar/scripts/save_word.py de",
    "signal": 8
  },
  "custom/wotd-fr": {
    "exec": "/usr/bin/python3 /home/rene/.config/waybar/scripts/wotd_lang.py fr",
    "interval": 3600,
    "format": " · FR: {}",
    "tooltip": true,
    "return-type": "json",
    "on-click-right": "/usr/bin/python3 /home/rene/.config/waybar/scripts/save_word.py fr",
    "signal": 8
  },
  "custom/wotd-it": {
    "exec": "/usr/bin/python3 /home/rene/.config/waybar/scripts/wotd_lang.py it",
    "interval": 3600,
    "format": " · IT: {}",
    "tooltip": true,
    "return-type": "json",
    "on-click-right": "/usr/bin/python3 /home/rene/.config/waybar/scripts/save_word.py it",
    "signal": 8
  },
  "custom/wotd-lat": {
    "exec": "/usr/bin/python3 /home/rene/.config/waybar/scripts/wotd_lat.py",
    "interval": "once",
    "format": " · LAT: {}",
    "return-type": "json",
    "tooltip": true,
    "signal": 11
  }
}