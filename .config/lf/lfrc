# ========================================
# FILE OPERATIONS
# ========================================

# Basic file operations
cmd mkdir $mkdir -p "$(echo $* | tr ' ' '\ ')"
cmd trash %trash-put $fx

cmd delete ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf -- "%s\n" $fx | sed 's|'"$HOME"'||'
	printf "\t\033[1;33mDelete? \033[37m[\033[32my\033[37m/\033[31mN\033[37m]\033[m "
	read -r REPLY
	case "$REPLY" in
		[yYsS]) rm -rf -- $fx ;;
	esac
}}

cmd shred ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf -- "%s\n" $fx | sed 's|'"$HOME"'||'
	printf "\t\033[1;34mShred permanently? \033[37m[\033[32my\033[37m/\033[31mN\033[37m]\033[m "
	read -r REPLY
	case "$REPLY" in
		[yYsS])
			for f in $fx; do
				if [ -f "$f" ]; then
					shred -u -n 3 "$f" >/dev/null 2>&1 &
				elif [ -d "$f" ]; then
					rshred -fdu "$f"
				fi
			done
		;;
	esac
}}

cmd chmodx &{{
	chmod u+x $fx
	lf -remote "send $id reload"
}}

# Bulk rename with editor
cmd bulkrename ${{
    old="$(mktemp)"
    new="$(mktemp)"
    [ -n "$fs" ] && fs="$(basename -a -- $fs)" || fs="$(ls)"
    printf '%s\n' "$fs" >"$old"
    printf '%s\n' "$fs" >"$new"
    $EDITOR "$new"
    [ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
    paste "$old" "$new" | while IFS=$'\t' read -r src dst; do
        [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
    done
    rm -- "$old" "$new"
    lf -remote "send $id unselect"
}}

# ========================================
# ARCHIVE OPERATIONS
# ========================================

cmd extract ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf -- "%s\n" $fx
	printf "\t\033[1;34mExtract archive? \033[37m[\033[32my\033[37m/\033[31mN\033[37m]\033[m "
	read -r REPLY
	case "$REPLY" in
		[yYsS]) aunpack $fx ;;
	esac
}}

cmd zip %zip -r "$f.zip" $fx
cmd tar %tar czf "$f.tar.gz" $fx

# ========================================
# COPY/MOVE OPERATIONS
# ========================================

cmd fzf-move ${{
    dest="$(fd -t d | fzf --header='Move to:')"
    [ -n "$dest" ] && mv -iv $fx "$dest"
}}

cmd fzf-copy ${{
    dest="$(fd -t d | fzf --header='Copy to:')"
    [ -n "$dest" ] && cp -ivr $fx "$dest"
}}

# ========================================
# CLIPBOARD OPERATIONS
# ========================================

cmd yank-path $printf '%s' "$f" | wl-copy
cmd yank-basename $basename -a -- $fx | wl-copy
cmd yank-dirname $dirname -- "$f" | wl-copy
cmd yank-fullpath $realpath "$f" | wl-copy
cmd yank-pwd $printf '%s' "$PWD" | wl-copy

# ========================================
# LINK OPERATIONS
# ========================================

cmd paste_link %{{
	IFS='\n'
	set -- $(cat ~/.local/share/lf/files)
	mode="$1"
	shift
	if [ $# -lt 1 ]; then
		lf -remote "send $id echo no files to link"
		exit 1
	fi
	case "$mode" in
		copy) ln -sr -t . -- "$@";;
		move) ln -t . -- "$@";;
	esac || exit $?
	rm ~/.local/share/lf/files
	lf -remote "send clear"
}}

cmd follow_link %{{
	lf -remote "send ${id} select \"$(readlink $f)\""
}}

cmd link ${{
    set -- $(cat ~/.local/share/lf/files)
    mode="$1"
    shift
    if [ "$#" -lt 1 ]; then
        lf -remote "send $id echo no files to link"
        exit 0
    fi
    case "$mode" in
        copy) ln -sr -t . -- "$@";;
        move) ln -t . -- "$@";;
    esac
    rm ~/.local/share/lf/files
    lf -remote "send clear"
}}

# ========================================
# NAVIGATION HELPERS
# ========================================

cmd broot ${{
	selected="$(broot)"
	if [ -d "$selected" ]; then
		lf -remote "send ${id} cd \"${selected}\""
	elif [ -e "$selected" ]; then
		lf -remote "send ${id} select \"${selected}\""
	else
		>&2 printf "Could not select %s\n" "${selected}"
	fi
}}

cmd zlua %{{
	lf -remote "send ${id} cd \"$(z.lua -e $*)\""
}}

cmd zlua_i ${{
	dir=$(z.lua -l "$@" \
		| fzf --nth 2.. --tac +s -e \
			--header "Frequent directories" --header-first \
			--preview "lsd --color always --icon always --tree --depth 3 --group-dirs first {+2} 2>/dev/null" \
		| awk '{print substr($0, index($0,$2))}'
	)
	lf -remote "send ${id} cd \"${dir}\""
}}

cmd gsh %{{
	lf -remote "send ${id} cd \"$(g.sh -x $*)\""
}}

cmd gsh_fuzzy %{{
	lf -remote "send ${id} cd \"$(_GS_GREP='fzf -f' g.sh -l $* | awk 'NR==1{print $2}')\""
}}

cmd gsh_i ${{
	selected=$(g.sh -l "$@" \
		| fzf --nth 2.. --tac +s -e \
		--header "Bookmarked directories" --header-first \
		--preview "lsd --color always --icon always --tree --depth 2 --group-dirs first {+2} 2>/dev/null" \
		| awk '{print substr($0, index($0,$2))}'
	)
	if [ -d "$selected" ]; then
		lf -remote "send ${id} cd \"${selected}\""
	elif [ -e "$selected" ]; then
		lf -remote "send ${id} select \"${selected}\""
	else
		>&2 printf "Could not select %s\n" "${selected}"
	fi
}}

# ========================================
# SELECTION HELPERS
# ========================================

cmd select-pattern ${{
    printf "Pattern: "
    read pattern
    lf -remote "send $id unselect"
    lf -remote "send $id glob-select $pattern"
}}

# ========================================
# GIT INTEGRATION
# ========================================

cmd git_status ${{
    clear
    git -C "$(dirname "$f")" status 2>/dev/null || git status
    read -p "Press enter to continue"
}}

cmd git_log ${{
    clear
    git -C "$(dirname "$f")" log --oneline --graph --decorate --all | less
}}

# ========================================
# IMAGE OPERATIONS
# ========================================

cmd img-resize ${{
    printf "Width: "; read width
    for f in $fx; do
        magick "$f" -resize "${width}x" "${f%.*}_${width}.${f##*.}"
    done
    lf -remote "send $id reload"
}}

cmd img-optimize ${{
    for f in $fx; do
        optipng "$f" 2>/dev/null || jpegoptim "$f" 2>/dev/null
    done
}}

cmd setbg "$1"

# ========================================
# UTILITY COMMANDS
# ========================================

cmd dirsize $du -sh $fx | less

cmd stop ${{
	kill -TSTP $(ps -p $$ -o 'ppid=')
}}

cmd edit-config ${{
    $EDITOR ~/.config/lf/lfrc
    lf -remote "send $id source ~/.config/lf/lfrc"
}}

# ========================================
# CUSTOM SCRIPTS
# ========================================

cmd remove_dupes ${{
    ~/.local/bin/public-scripts/remove-dupes.sh "$PWD"
}}

cmd prefix_files ${{
    [ -n "$fs" ] && printf '%s\n' $fs | ~/.local/bin/public-scripts/prefix-files.sh || echo "No files selected."
}}

cmd rsyncpull ${{
    ~/.local/bin/public-scripts/rsync-pull $fx
    lf -remote "send $id echo '✅ Downloaded with rsync'"
}}

cmd rsync-to-mint ${{
    set -f
    rsync -avz --progress -- $fx rene@192.168.194.213:~/Videos/
    lf -remote "send $id echo '✅ Transferred to mint Videos'"
