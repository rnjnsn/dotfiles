map gn cd ~/notes

# Shell aliases in lf: ' + alias name + Enter, e.g. 'dl ⏎ or 'cv ⏎.
# Reads ~/.aliases.bash, so the names are always the same as in the shell.
# "cd" aliases go to the folder (or select the file), editor aliases open the file.
cmd goto ${{
    def=$(bash -c 'shopt -s expand_aliases; source ~/.aliases.bash >/dev/null 2>&1; alias -- "$1"' _ "$1" 2>/dev/null) || true
    if [ -z "$def" ]; then
        lf -remote "send $id echoerr No alias named '$1' in ~/.aliases.bash"
        exit 0
    fi
    eval "set -- ${def#*=}"   # alias prints name='value'; unquote the value
    eval "set -- $1"          # split it into words, expanding ~ and $VARS
    command=$1; shift
    case "$command" in
        cd)
            if [ -d "$1" ]; then
                lf -remote "send $id cd \"$1\""
            else
                lf -remote "send $id select \"$1\""
            fi ;;
        nvim|vim|vi|"${EDITOR:-nvim}")
            "${EDITOR:-nvim}" "$@" ;;
        *)
            lf -remote "send $id echoerr Alias '$command…' is not a folder or file alias" ;;
    esac
}}
map "'" push :goto<space>

