# ========================================
# LF CONFIGURATION
# ========================================
# Image previews: the previewer draws real sixel images in terminals that
# support them (foot, also inside tmux) and colored text art otherwise
# (Alacritty). `set sixel true` lets lf display the sixel output.

# ========================================
# GENERAL SETTINGS
# ========================================
set period 1
set hidden!
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml"
set sixel true
set previewer '~/.config/lf/previewer'
set incsearch
set incfilter
set ratios 1:2:3

# zp: toggle a large preview (hides the parent column, preview takes 4/5)
cmd toggle-big-preview &{{
    if [ "$lf_ratios" = "1:4" ]; then
        lf -remote "send $id set ratios 1:2:3"
    else
        lf -remote "send $id set ratios 1:4"
    fi
}}
set truncatechar "…"
set waitmsg "\033[1;31m⏎ to continue...\033[m"
set timefmt "02/01/2006 15:04:05 "
set infotimefmtnew '02/01 15:04'
set infotimefmtold '02/01/06'
set errorfmt "\033[1;31m"
set numberfmt "\033[38;2;75;87;116m"
set dircounts
set tabstop 4
set scrolloff 5
set wrapscroll
set shellopts '-eu'
set ifs "\n"
set shell "bash"
set ruler 'df:acc:progress:selection:filter:ind'
set cursorpreviewfmt "\033[7m"

# Prompt formatting
set promptfmt "
 \033[48;2;23;147;209;38;2;255;255;255m \033[38;2;23;147;209;48;2;202;31;31m
\033[38;2;202;31;31;48;2;40;47;62m
\033[38;2;255;255;255m %w 
\033[38;2;40;47;62;48;2;58;67;89m
\033[38;2;255;255;255m %f 
\033[38;2;58;67;89;49m\033[m"

source '~/.config/lf/opener'

%test $LF_LEVEL -eq 1 || >&2 printf "Warning: You are inside a nested lf instance!"

# ========================================
# KEY MAPPINGS - SORTING
# ========================================

map st :set sortby time; set reverse true
map sn :set sortby name; set reverse false
map ss :set sortby size; set reverse true
map sa :set sortby atime; set reverse true
map sc :set sortby ctime; set reverse true
map se :set sortby ext; set reverse false
