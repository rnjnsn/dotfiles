#!/bin/sh
# lf previewer. Arguments: $1 file, $2 width, $3 height, $4 x, $5 y.
# Images: real sixel images when the terminal supports them (foot, also through
# tmux), otherwise colored text art (Alacritty). Both drawn by chafa.

sixel_ok() {
    if [ -n "$TMUX" ]; then
        tmux display -p '#{client_termfeatures}' 2>/dev/null | grep -q sixel
    else
        case "$TERM" in foot*|xterm-kitty|wezterm|*sixel*) return 0 ;; *) return 1 ;; esac
    fi
}

image() {
    if sixel_ok; then
        w=$(($2 - 1)) h=$3
        if [ -n "$TMUX" ]; then
            # tmux silently drops escape sequences larger than 1 MiB, so
            # detailed images (photos, busy screenshots) never appear.
            # Shrink the image until its sixel data fits under that limit.
            tmp=$(mktemp)
            for _ in 1 2 3 4 5 6; do
                chafa -f sixels -s "${w}x${h}" --animate off --polite on "$1" >"$tmp"
                [ "$(stat -c %s "$tmp")" -lt 1000000 ] && break
                w=$((w * 3 / 4)) h=$((h * 3 / 4))
            done
            cat "$tmp"
            rm -f "$tmp"
        else
            chafa -f sixels -s "${w}x${h}" --animate off --polite on "$1"
        fi
    else
        chafa -f symbols -s "$(($2 - 1))x$3" --animate off --polite on "$1"
    fi
    exit 0
}

case "$(file --dereference -b --mime-type -- "$1")" in
    image/svg+xml)
        cache="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat -L -c '%n%s%Y' -- "$1" | sha256sum | cut -d' ' -f1).png"
        [ -f "$cache" ] || magick -background none -density 150 "$1" -resize '1024x1024>' "$cache" 2>/dev/null
        image "$cache" "$2" "$3"
        ;;
    image/*)
        image "$1" "$2" "$3"
        ;;
    # Text files
    text/*|*/xml|application/javascript|application/x-subrip)
        bat --color=always --style=numbers --pager=never "$1" 2>/dev/null || cat "$1"
        ;;
    # JSON
    application/json)
        jq -C < "$1" 2>/dev/null || cat "$1"
        ;;
    # Archives
    application/zip|application/x-7z-compressed)
        atool --list -- "$1" 2>/dev/null || echo "Archive: $1"
        ;;
    # PDF (first page as text)
    */pdf)
        pdftotext "$1" - 2>/dev/null || echo "PDF: $1"
        ;;
    # Audio/video metadata
    audio/*|video/*)
        exiftool "$1" 2>/dev/null || echo "Media file: $1"
        ;;
    # Everything else
    *)
        file --dereference --brief -- "$1"
        ;;
esac
