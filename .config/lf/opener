cmd open ${{
    dem() {
        setsid -f "$@" >/dev/null 2>&1
    }

    real_f=$(readlink -f "$f" 2>/dev/null || realpath "$f" 2>/dev/null || echo "$f")
    mime_type=$(file -b --mime-type -- "$real_f")

    case "$mime_type" in
        application/pdf|application/postscript|image/vnd.djvu|application/epub+zip)
            dem "${READER:-zathura}" "$real_f" ;;

        text/html)
            case "${real_f##*.}" in
                xls|xlsx|xlsm|ods|fods|gnumeric|csv|tsv)
                    dem gnumeric "$real_f" ;;
                *)
                    "${EDITOR:-nvim}" "$real_f" ;;
            esac ;;

        text/troff)
            case "${real_f##*.}" in
                [0-9]|[01]p|[23]*)
                    man "$real_f" ;;
                *)
                    "${EDITOR:-nvim}" "$real_f" ;;
            esac ;;

        text/*|application/json|application/javascript|application/pgp-encrypted|inode/x-empty|application/octet-stream|application/x-gettext-translation)
            case "${real_f##*.}" in
                xls|xlsx|xlsm|ods|fods|gnumeric|csv|tsv)
                    dem gnumeric "$real_f" ;;
                *)
                    case "$mime_type" in
                        application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/vnd.oasis.opendocument.spreadsheet|application/vnd.ms-excel.sheet.macroenabled.12)
                            dem gnumeric "$real_f" ;;
                        *)
                            "${EDITOR:-nvim}" "$real_f" ;;
                    esac ;;
            esac ;;

        image/x-*)
            dem "${IMAGE_EDITOR:-gimp}" "$real_f" ;;

        image/*)
            # Open the whole folder in imv, starting at this image
            if [ -z "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; then
                "${MPV:-mpv}" --keep-open "$real_f"
            else
                dem imv -n "$real_f" "${real_f%/*}"
            fi ;;

        audio/*)
            if [ -z "$DISPLAY" ]; then
                "${MPV:-mpv}" --audio-display=no "$real_f"
            else
                dem "${TERMINAL:-alacritty}" -e "${MPV:-mpv}" --audio-display=no "$real_f"
            fi ;;

        video/*)
            if [ -z "$DISPLAY" ]; then
                "${MPV:-mpv}" "$real_f"
            else
                dem "${MPV:-mpv}" "$real_f"
            fi ;;
    esac
}}
