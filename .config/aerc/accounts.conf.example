# Copy to accounts.conf (chmod 600). In source = URLs, write @ in the user name as %40.
[gmail]
source        = imaps://GMAIL_ADDRESS@imap.gmail.com:993
source-cred-cmd = pass show mail/gmail-app | head -n1
outgoing      = msmtp --read-envelope-from
default       = INBOX
from          = Rene <GMAIL_ADDRESS>
archive       = [Gmail]/All Mail
postpone      = [Gmail]/Drafts
cache-headers = true
folders-sort  = INBOX,[Gmail]/Starred,[Gmail]/Sent Mail,[Gmail]/Drafts

[proton]
# Proton Mail Bridge on localhost (plain IMAP over loopback; bridge itself encrypts to Proton)
source        = imap+insecure://PROTON_ADDRESS@127.0.0.1:1143
source-cred-cmd = { pass show mail/proton-bridge-imap 2>/dev/null || pass show mail/proton-bridge; } | head -n1
outgoing      = msmtp --read-envelope-from
aliases       = DOMAIN_ADDRESS, PM_ADDRESS
default       = INBOX
from          = Rene <PROTON_ADDRESS>
archive       = Archive
postpone      = Drafts
cache-headers = true
folders-sort  = INBOX,Starred,Sent,Drafts,Archive
