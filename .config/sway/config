# --- ported general/decoration/input settings ---
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY

gaps inner 5
gaps outer 10
default_border pixel 3
# Red borders (active CF3838, inactive C77777)
#                       border   bg       text     indicator child_border
client.focused          #CF3838  #CF3838  #ffffff  #CF3838   #CF3838
client.focused_inactive #C77777  #C77777  #ffffff  #C77777   #C77777
client.unfocused        #C77777  #C77777  #ffffff  #C77777   #C77777
input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}
input "type:touchpad" {
    accel_profile flat
    pointer_accel 0
}
input "type:keyboard" {
    xkb_layout us,dk,de
}
output eDP-1 resolution 1920x1200@60Hz scale 1 position 2560,0
output DP-1 resolution 3840x2160@60Hz scale 1.5 position 0,0
output eDP-1 dpms on
output DP-1 dpms on

# --- workspace-to-output pinning ---
# Each workspace prefers DP-1 (big screen) and falls back to eDP-1 (laptop)
# when DP-1 is not connected. When DP-1 is plugged back in, sway moves the
# workspaces back to it automatically.
workspace 10 output eDP-1
workspace 1 output DP-1 eDP-1
workspace 2 output DP-1 eDP-1
workspace 3 output DP-1 eDP-1
workspace 4 output DP-1 eDP-1
workspace 5 output DP-1 eDP-1
workspace 6 output DP-1 eDP-1
workspace 7 output DP-1 eDP-1
workspace 8 output DP-1 eDP-1
workspace 9 output DP-1 eDP-1

# Start on workspace 1 (lands on DP-1 if connected, otherwise the laptop)
workspace number 1
exec waybar
exec waybar -c ~/.config/waybar/config-bottom.json -s ~/.config/waybar/style-bottom.css
exec obsidian --ozone-platform=wayland --enable-features=UseOzonePlatform
exec sleep 1 && systemctl --user restart pipewire pipewire-pulse wireplumber
set $terminal foot
set $browser firefox
set $anki ~/.pyenv/shims/anki
set $notes_app obsidian --ozone-platform=wayland --enable-features=UseOzonePlatform
set $mail ~/.local/bin/public-scripts/protonmail-wayland.sh
set $calendar ~/.local/bin/public-scripts/calendar-wayland.sh
set $menu ~/.local/bin/public-scripts/fuzzel-run-path
assign [app_id="^firefox$"] workspace number 2
assign [app_id="^Alacritty$"] workspace number 1
assign [app_id="^foot$"] workspace number 1
assign [app_id="^md\.obsidian\.Obsidian$"] workspace number 3
for_window [app_id="^(chrome-calendar\.proton\.me__-Default)$"] floating disable
for_window [title="^(Proton Mail.*)$"] floating disable
for_window [app_id="^(chrome-.*)$"] floating disable
set $mainMod Mod4
floating_modifier $mainMod normal
bindsym $mainMod+Shift+Return exec $terminal
bindsym $mainMod+Shift+b exec $browser
bindsym $mainMod+Shift+n exec $notes_app
bindsym $mainMod+Shift+m exec sh -c 'swaymsg "workspace number 5" && sleep 0.3 && $mail'
bindsym $mainMod+Shift+c exec sh -c 'swaymsg "workspace number 6" && sleep 0.3 && $calendar'
bindsym $mainMod+p exec $menu
# Super+Shift+P: pick a colour on screen, hex goes to the clipboard
bindsym Mod4+Shift+P exec ~/.local/bin/public-scripts/colorpick
bindsym $mainMod+Shift+q kill
bindsym $mainMod+j focus down
bindsym $mainMod+k focus up
bindsym $mainMod+h focus left
bindsym $mainMod+l focus right
# DWM-like window movement
bindsym $mainMod+Shift+j move down
bindsym $mainMod+Shift+k move up
# DWM-like resizing
bindsym $mainMod+Shift+h resize shrink width 5 ppt
bindsym $mainMod+Shift+l resize grow width 5 ppt
# Swap focused window with master
bindsym $mainMod+Return exec i3a-swap
bindsym $mainMod+t exec ~/.config/waybar/scripts/timer.sh toggle
# Move window to the other monitor, focus follows
bindsym $mainMod+Control+h move container to output left, focus output left
bindsym $mainMod+Control+l move container to output right, focus output right
bindsym $mainMod+space floating toggle
bindsym $mainMod+Shift+space input type:keyboard xkb_switch_layout next
bindsym $mainMod+f fullscreen toggle
bindsym $mainMod+1 workspace number 1
bindsym $mainMod+2 workspace number 2
bindsym $mainMod+3 workspace number 3
bindsym $mainMod+4 workspace number 4
bindsym $mainMod+5 workspace number 5
bindsym $mainMod+6 workspace number 6
bindsym $mainMod+7 workspace number 7
bindsym $mainMod+8 workspace number 8
bindsym $mainMod+9 workspace number 9
bindsym --to-code $mainMod+Control+Shift+1 move container to workspace number 1
bindsym --to-code $mainMod+Control+Shift+2 move container to workspace number 2
bindsym --to-code $mainMod+Control+Shift+3 move container to workspace number 3
bindsym --to-code $mainMod+Control+Shift+4 move container to workspace number 4
bindsym --to-code $mainMod+Control+Shift+5 move container to workspace number 5
bindsym --to-code $mainMod+Control+Shift+6 move container to workspace number 6
bindsym --to-code $mainMod+Control+Shift+7 move container to workspace number 7
bindsym --to-code $mainMod+Control+Shift+8 move container to workspace number 8
bindsym --to-code $mainMod+Control+Shift+9 move container to workspace number 9
bindsym $mainMod+comma focus output left
bindsym $mainMod+period focus output right
bindsym $mainMod+Control+Shift+h move workspace to output left
bindsym $mainMod+Control+Shift+l move workspace to output right
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym $mainMod+Shift+x exit
exec wl-paste --type text --watch sh -c '~/.local/bin/public-scripts/cliphist add'
bindsym Mod4+V exec ~/.local/bin/public-scripts/cliphist sel
bindsym $mainMod+s exec sh -c 'mkdir -p ~/pics/screenshots && FILE=~/pics/screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && grim "$FILE" && cat "$FILE" | wl-copy --type image/png && cat "$FILE" | wl-copy --primary --type image/png'
bindsym $mainMod+Shift+s exec sh -c 'mkdir -p ~/pics/screenshots && FILE=~/pics/screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && grim -g "$(slurp)" "$FILE" && cat "$FILE" | wl-copy --type image/png && cat "$FILE" | wl-copy --primary --type image/png'
bindsym $mainMod+Shift+e exec sh -c 'mkdir -p ~/pics/screenshots && FILE=~/pics/screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && grim -g "$(slurp)" - | swappy -f - -o "$FILE" && cat "$FILE" | wl-copy --type image/png && cat "$FILE" | wl-copy --primary --type image/png'
exec dunst
# imv: floating, centered, slightly see-through
for_window [app_id="^imv$"] floating enable, move position center, opacity 0.85
bindsym $mainMod+minus [app_id="^(imv|dwds)$"] opacity minus 0.1
bindsym $mainMod+equal [app_id="^(imv|dwds)$"] opacity plus 0.1
# dwds popup: floating, centered
for_window [app_id="^dwds$"] floating enable, resize set 900 750, move position center, opacity 0.85
exec ~/.config/swaybg/launch.sh
bindsym $mainMod+Shift+f exec $anki
exec /home/rene/.local/bin/i3a-master-stack --stack=dwm --stack-size=35
# Swallowing: zathura/mpv started from a foot terminal take over its tile; the
# terminal returns to the same spot when they close (log: sway-swallow --debug)
exec ~/.local/bin/public-scripts/sway-swallow
bindsym $mainMod+Shift+z exec swaylock
bindsym Mod4+Shift+t exec ~/.local/bin/private-scripts/claude-translate

# --- idle / lock / night light / automount (added 2026-11-15) ---
# Lock after 10 min idle, screens off after 15 min, always lock before suspend.
exec swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
# Don't idle-lock while something is fullscreen (videos, presentations)
for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen
# Warmer screen colours in the evening
exec wlsunset -S 07:00 -s 20:00 -t 4000
# Auto-mount USB drives with a notification
exec udiskie --automount --notify

# --- Firefox glue (2026-11-16) ---
# Super+y: play the copied URL in mpv (Vimium C: yy = this page, yf = hint a link)
bindsym $mainMod+y exec ~/.local/bin/public-scripts/mpv-url
# Super+o: fuzzel over Firefox bookmarks + history; free text = DuckDuckGo search
bindsym $mainMod+o exec ~/.local/bin/public-scripts/ffpick
# Super+F1: fuzzy search over all keybindings (~/notes/00_inbox/keybindings.md)
bindsym $mainMod+F1 exec ~/.local/bin/public-scripts/kb-search
# Super+Shift+F1: the same note as a PDF in zathura (rebuilt when the note changes)
bindsym $mainMod+Shift+F1 exec ~/.local/bin/public-scripts/kb-pdf
# Same without Fn (the HHKB has no F-row): Super+/ search, Super+? (Shift+/) PDF
bindsym --to-code $mainMod+slash exec ~/.local/bin/public-scripts/kb-search
bindsym --to-code $mainMod+Shift+slash exec ~/.local/bin/public-scripts/kb-pdf
# Picture-in-Picture: small, floating, sticky, bottom-right
for_window [app_id="firefox" title="^Picture-in-Picture$"] floating enable, sticky enable, resize set 640 360, move position 100 ppt 100 ppt, move left 660 px, move up 380 px

# pavucontrol (waybar volume click): float it at a usable size instead of tiling
for_window [app_id="^org\.pulseaudio\.pavucontrol$"] floating enable, resize set 900 600, move position center

# --- Bar keyboard mode (2026-11-17) ---
# Super+b, then one key, like Vimium hints for the bar. Yellow letters appear
# next to each bar item while the mode is active. Esc/Return cancel.
set $bs ~/.config/waybar/scripts
set $barmode <span color='#ffcc66'>BAR</span> press a yellow letter · Esc cancels
mode --pango_markup "$barmode" {
    bindsym h exec $bs/net.sh hotspot, mode "default"
    bindsym w exec $bs/net.sh pick, mode "default"
    bindsym v exec sh -c 'if nordvpn status | grep -q "Status: Connected"; then nordvpn disconnect; else nordvpn connect; fi | tail -1 | xargs -0 notify-send -a NordVPN NordVPN', mode "default"
    bindsym t exec $bs/timer.sh toggle, mode "default"
    bindsym d exec $bs/timer.sh length, mode "default"
    bindsym a exec ~/.local/bin/public-scripts/todo menu, mode "default"
    bindsym o exec ~/.local/bin/public-scripts/todo plan, mode "default"
    bindsym p exec pavucontrol, mode "default"
    bindsym k input type:keyboard xkb_switch_layout next, mode "default"
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym $mainMod+b mode "default"
}
bindsym $mainMod+b mode "$barmode"

# Bar listener: new Anki/Latin word on workspace switch + Super+b hint letters
exec ~/.config/waybar/scripts/bar-listener.sh

# ncmpcpp: floating, centered, big enough (ncmpcpp freezes below ~6 rows)
bindsym $mainMod+m exec $terminal --app-id=ncmpcpp ncmpcpp
for_window [app_id="^ncmpcpp$"] floating enable, resize set 1100 700, move position center
