#!/bin/bash
# Run a Claude Code analysis from the terminal and save it to the notes inbox.
# Usage:
#   claude-passage "text"            text as arguments
#   echo "text" | claude-passage      text from a pipe
#   claude-passage                    opens your editor to paste text
set -euo pipefail

CMD_NAME="analyze_passage"
ZET_DIR="/home/rene/notes/00_inbox"
CMD_FILE="$HOME/.claude/commands/$CMD_NAME.md"

[ -f "$CMD_FILE" ] || { echo "Error: $CMD_FILE not found. Re-run the installer."; exit 1; }
[ -d "$ZET_DIR" ] || { echo "Error: notes folder not found at $ZET_DIR"; exit 1; }
command -v claude >/dev/null 2>&1 || { echo "Error: 'claude' (Claude Code) is not on your PATH."; exit 1; }

# --- Get the input -----------------------------------------------------------
if [ $# -gt 0 ]; then
    input="$*"
elif [ ! -t 0 ]; then
    input=$(cat)
else
    tmp=$(mktemp "${TMPDIR:-/tmp}/claude-input.XXXXXX")
    cat > "$tmp" <<'EOF'
%% Paste or type below. Lines starting with %% are ignored.
%% For a passage, add the source on its own line at the end, e.g.:
%% -- Wittgenstein, Tractatus Logico-Philosophicus (1921)
%% Save and quit to run; quit without adding text to cancel.

EOF
    "${EDITOR:-nvim}" "$tmp"
    input=$(grep -v '^%%' "$tmp" || true)
    rm -f "$tmp"
fi

[ -n "${input//[[:space:]]/}" ] || { echo "Nothing to analyze."; exit 1; }

# --- Build the prompt from the slash-command file ----------------------------
body=$(awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next} !fm' "$CMD_FILE")
shopt -u patsub_replacement 2>/dev/null || true   # keep "&" literal in bash 5.2+
prompt="${body//\$ARGUMENTS/$input}"

# --- Run Claude headless -----------------------------------------------------
marker=$(mktemp "${TMPDIR:-/tmp}/claude-marker.XXXXXX")
echo "Analyzing… this usually takes a few minutes."

cd "$ZET_DIR"
printf '%s' "$prompt" | claude -p \
    --add-dir "$ZET_DIR" --add-dir /home/rene/notes \
    --allowedTools "Write,Read,WebSearch,WebFetch,Bash(date:*),Bash(ls:*),Bash(test:*),Bash(echo:*),Bash(find:*)"

# --- Find the new note and open it -------------------------------------------
note=$(find "$ZET_DIR" -maxdepth 1 -name '*.md' -newer "$marker" -print 2>/dev/null \
       | while IFS= read -r f; do printf '%s\t%s\n' "$(date -r "$f" +%s)" "$f"; done \
       | sort -rn | head -1 | cut -f2-)
rm -f "$marker"

if [ -z "$note" ]; then
    echo "No new note was created in $ZET_DIR."
    exit 1
fi

# --- Keep the note name unique across the vault (governance §4) -------------
# Links resolve by file name, so a clash with any note elsewhere in ~/notes
# breaks them. Rename the new note to <name>-2, -3, … until it is unique.
VAULT="$HOME/notes"
base=$(basename "$note" .md); name="$base"; n=2
while find "$VAULT" -path "$VAULT/.git" -prune -o -iname "$name.md" ! -samefile "$note" -print -quit | grep -q .; do
    name="$base-$n"; n=$((n + 1))
done
if [ "$name" != "$base" ]; then
    new="$(dirname "$note")/$name.md"
    mv -n "$note" "$new"
    echo "Renamed to $name.md: a note named $base.md already exists in the vault."
    note="$new"
fi

echo "$note" > /tmp/last_zettel
echo "Created note: $note"

if [ -z "${NVIM:-}" ] && [ -t 1 ]; then
    nvim "$note"
else
    echo "(Not opening inside Neovim)"
fi
