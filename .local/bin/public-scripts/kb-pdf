#!/usr/bin/env bash
# Open the keybindings note as a PDF in zathura; rebuild it when the note is newer.
set -euo pipefail
note="${KB_NOTE:-$HOME/notes/00_inbox/keybindings.md}"
dir="$HOME/.cache/keybindings"; pdf="$dir/keybindings.pdf"; css="$dir/style.css"
mkdir -p "$dir"
cat > "$css" <<'CSS'
@page { size: A4; margin: 12mm; }
body { font: 9pt/1.3 sans-serif; columns: 2; column-gap: 8mm; }
h1 { column-span: all; font-size: 16pt; margin: 0 0 4pt; }
h2 { column-span: all; font-size: 13pt; border-bottom: 1px solid #888; margin: 10pt 0 4pt; }
h3 { font-size: 11pt; margin: 8pt 0 2pt; break-after: avoid; }
h4 { font-size: 9.5pt; margin: 6pt 0 2pt; break-after: avoid; }
p { margin: 2pt 0; }
table { width: 100%; border-collapse: collapse; margin-bottom: 4pt; }
tr { break-inside: avoid; }
th, td { text-align: left; vertical-align: top; padding: 1pt 3pt; border-bottom: 0.5pt solid #ddd; }
table { table-layout: fixed; }
th:first-child { width: 55%; }
td { overflow-wrap: anywhere; }
td:nth-child(2) { font-family: monospace; font-weight: bold; }
th { background: #eee; }
code { font-size: 8.5pt; }
CSS
if [[ ! -f "$pdf" || "$note" -nt "$pdf" ]]; then
  # body only: drop frontmatter, the Category column, and everything from "## Connections" on; unwrap [[links]];
  # promote headings one level (## -> #)
  awk 'NR==1 && /^---$/ {fm=1; next} fm && /^---$/ {fm=0; next} fm {next}
       /^## Connections/ {exit}
       /^\| Does \| Key \| Category \|$/ {cat=1; print "| Does | Key |"; next}
       cat && /^\|/ {if ($0 ~ /^\|---\|---\|---\|$/) print "|---|---|"; else {sub(/ [^|]*\|$/, ""); print}; next}
       {cat=0; print}' "$note" \
    | sed -E 's/\[\[([^]|]+)(\|[^]]+)?\]\]/\1/g; s/^#(#+ )/\1/' \
    | pandoc -f markdown -t html5 --standalone --metadata title=" " \
        --css "$css" --pdf-engine=weasyprint -o "$pdf" 2>"$dir/build.log" \
    || { notify-send -a keybindings "kb-pdf: build failed" "see $dir/build.log"; exit 1; }
fi
[[ -n "${KB_NOOPEN:-}" ]] && exit 0
exec zathura "$pdf"
