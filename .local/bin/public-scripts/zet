#!/bin/bash

# Set the Zettelkasten directory
ZET_DIR="$HOME/notes/00_inbox"

# Function to convert title to lowercase with hyphens
sanitize_filename() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:] ' | tr ' ' '-'
}

# Function to convert title to Title Case
title_case() {
    echo "$1" | awk 'BEGIN{FS=OFS=" "} {for(i=1;i<=NF;i++)sub(/./,toupper(substr($i,1,1)),$i)}1'
}

# Check if the directory exists
if [ ! -d "$ZET_DIR" ]; then
    echo "Error: Zettelkasten directory not found at $ZET_DIR"
    exit 1
fi

# Prompt user for note title
echo -n "Enter note title: "
read input_title

# Sanitize filename and title
filename_title=$(sanitize_filename "$input_title")
content_title=$(title_case "$input_title")

# Prompt user for additional tags
echo -n "Enter additional tags (space-separated): "
read additional_tags

# Combine tags and format for YAML
all_tags="resources zettelkasten $additional_tags"
yaml_tags=$(echo "$all_tags" | sed 's/[[:space:]]\+/\n  - /g')

# Build full path to new note
filename="$ZET_DIR/$filename_title.md"

# Create the markdown note
cat > "$filename" << EOL
---
title: "$content_title"
created: $(date '+%Y-%m-%d %H:%M:%S')
tags:
  - ${yaml_tags}
---

## $content_title


## Connections


## Sources


## Questions


EOL

# Save the note path so Neovim can open it
echo "$filename" > /tmp/last_zettel

# Notify user and optionally open the note
echo "Created note: $filename"

# Only open in nvim if not already inside Neovim
if [ -z "$NVIM" ]; then
  nvim "$filename"
else
  echo "(Not opening inside Neovim)"
fi
