#!/bin/bash
# zet: create a new Zettelkasten note in ~/notes/00_inbox and open it in nvim.

ZET_DIR="$HOME/notes/00_inbox"

# Title -> file name: transliterate æøå/äöüß, lowercase, keep letters/digits, spaces -> hyphens
sanitize_filename() {
    echo "$1" \
        | sed 's/æ/ae/g; s/Æ/Ae/g; s/ø/oe/g; s/Ø/Oe/g; s/å/aa/g; s/Å/Aa/g;
               s/ä/ae/g; s/Ä/Ae/g; s/ö/oe/g; s/Ö/Oe/g; s/ü/ue/g; s/Ü/Ue/g; s/ß/ss/g' \
        | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null \
        | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:] -' \
        | tr -s ' ' | sed 's/^ //; s/ $//' | tr ' ' '-'
}

# Title Case for the heading (works on æøå etc.)
title_case() {
    python3 -c 'import sys; print(" ".join(w[:1].upper() + w[1:] for w in sys.argv[1].split()))' "$1"
}

if [ ! -d "$ZET_DIR" ]; then
    echo "Error: Zettelkasten directory not found at $ZET_DIR"
    exit 1
fi

echo -n "Enter note title: "
read -r input_title
if [ -z "${input_title// }" ]; then
    echo "No title given, nothing created."
    exit 1
fi

filename_title=$(sanitize_filename "$input_title")
content_title=$(title_case "$input_title")
filename="$ZET_DIR/$filename_title.md"

# Never overwrite an existing note
if [ -e "$filename" ]; then
    echo "A note with that name already exists: $filename"
    echo "Opening it instead."
else
    echo -n "Enter additional tags (space-separated): "
    read -r additional_tags

    # One "  - tag" line per tag; empty input adds nothing
    yaml_tags=""
    for tag in $additional_tags; do
        yaml_tags+="  - ${tag#\#}"$'\n'
    done
    [ -n "$yaml_tags" ] && yaml_tags="tags:"$'\n'"$yaml_tags"

    # Escape double quotes for the YAML title
    yaml_title=${content_title//\"/\\\"}

    cat > "$filename" << EOL
---
title: "$yaml_title"
created: $(date '+%Y-%m-%d %H:%M:%S')
type: note
status: stub
${yaml_tags}---
## $content_title


## Connections


## Sources


## Questions


EOL
    echo "Created note: $filename"
fi

# Save the note path so Neovim's :Zet can open it
echo "$filename" > /tmp/last_zettel

# Only open in nvim if not already inside Neovim
if [ -z "$NVIM" ]; then
    nvim "$filename"
else
    echo "(Not opening inside Neovim)"
fi
