#!/usr/bin/env python3
"""Fuzzy search over every '| Does | Key |' table in the keybindings note.

Rows show as  Kind: App › Area │ Action │ Does │ Key  in fuzzel. Enter copies the key
to the clipboard and shows the whole row as a notification.
"""
import os, re, subprocess, sys

NOTE = os.path.expanduser(os.environ.get("KB_NOTE", "~/notes/00_inbox/keybindings.md"))

def cells(line):
    parts = re.split(r"(?<!\\)\|", line.strip().strip("|"))
    return [p.strip().replace("\\|", "|").replace("\\\\", "\\") for p in parts]

def plain(s):
    s = re.sub(r"\[\[([^\]|]+)(\|[^\]]+)?\]\]", r"\1", s)
    s = re.sub(r"\*\*(.+?)\*\*", r"\1", s)          # **bold**
    s = re.sub(r"(?<!\S)\*(\S[^*]*?\S)\*", r"\1", s)  # *italic* (keeps a lone * key)
    return s.replace("`", "")

rows, app, group, in_table = [], "", "", False
for line in open(NOTE, encoding="utf-8"):
    if line.startswith("#### "):
        app, group = line[5:].strip(), ""
        app = re.sub(r"\s*\(.*\)$", "", app)          # "tmux (prefix Ctrl-a)" -> "tmux"
    elif re.match(r"^\*\*[^*]+\*\*", line) and not line.startswith("|"):
        group = re.match(r"^\*\*([^*]+)\*\*", line).group(1).rstrip(":")
    elif line.startswith("|"):
        c = cells(line)
        if c[:2] == ["Does", "Key"]:
            in_table = True
        elif in_table and not set(c[0]) <= set("-: "):
            rows.append((app + (f" › {group}" if group else ""),
                         c[2] if len(c) > 2 else "", plain(c[0]), plain(c[1])))
    else:
        in_table = False

def cut(s, n):
    return s if len(s) <= n else s[: n - 1] + "…"

lines = [f"{cut(a, 40):<40} │ {g:<8} │ {cut(d, 60):<60} │ {k}" for a, g, d, k in rows]
res = subprocess.run(
    ["fuzzel", "--dmenu", "--index", "--anchor=center", "--lines=25", "--width=160",
     "--prompt=keys › "],
    input="\n".join(lines), text=True, capture_output=True)
if res.returncode != 0 or not res.stdout.strip().isdigit():
    sys.exit(0)
a, g, d, k = rows[int(res.stdout.strip())]
subprocess.run(["wl-copy", "--", k])
subprocess.run(["notify-send", "-a", "keybindings", f"{k}", f"{a} · {g}\n{d}"])
